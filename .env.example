# Copy this file to .env.local. Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Aoede

# Firestore upload server (npm run server)
FIREBASE_PROJECT_ID=william-japanese-learn
# Path to a service-account JSON downloaded from Firebase console
FIREBASE_SERVICE_ACCOUNT_PATH=
PORT=8787
